rules_version = '2';

// TidyNest security rules.
// Paste this whole file into Firebase console -> Firestore Database -> Rules, then Publish.
//
// What it enforces:
//  - You must be signed in to do anything.
//  - A household can only be read or changed by the people in its "members" list.
//  - The only way onto a members list is a valid, unexpired invite code made by an existing member.
//  - Shared items are visible to the whole household. Private items are visible only to whoever made them.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    function validInvite(hid, code) {
      let invite = get(/databases/$(database)/documents/invites/$(code)).data;
      return invite.householdId == hid && invite.expiresAt > request.time;
    }

    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Anyone signed in can start a household, with themselves as the only member.
      allow create: if signedIn()
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;

      // An existing member can change household details, but not who the members are.
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      // Someone with a valid invite code can add themselves (and only themselves).
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'joinedWith'])
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.hasAll(resource.data.members)
        && request.auth.uid in request.resource.data.members
        && resource.data.members.size() < 10
        && request.resource.data.joinedWith is string
        && validInvite(hid, request.resource.data.joinedWith);

      allow delete: if false;

      match /items/{itemId} {
        function canSee(item) {
          return item.shared == true || item.createdBy == request.auth.uid;
        }

        function validItem(item) {
          return item.title is string
            && item.title.size() > 0
            && item.title.size() <= 200
            && item.type in ['reminder', 'calendar', 'timer']
            && item.date is string
            && item.shared is bool;
        }

        function sharingAllowed(before, after) {
          return after.shared == before.shared || before.createdBy == request.auth.uid;
        }

        allow read: if isMember(hid) && canSee(resource.data);

        allow create: if isMember(hid)
          && request.resource.data.createdBy == request.auth.uid
          && validItem(request.resource.data);

        // Anyone who can see an item can edit it, but only its creator can switch it
        // between shared and private, and nobody can change who created it.
        allow update: if isMember(hid)
          && canSee(resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && sharingAllowed(resource.data, request.resource.data)
          && validItem(request.resource.data);

        allow delete: if isMember(hid) && canSee(resource.data);
      }
    }

    // Invite codes. The code itself is the secret: you can look one up if you know it,
    // but nobody can list them.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if isMember(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && code.size() >= 8;

      allow update: if false;
      allow delete: if isMember(resource.data.householdId);
    }
  }
}
